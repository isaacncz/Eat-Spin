{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:cache *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run ci:local *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(node --test .claude/hooks/guard-delivery.test.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-delivery.mjs\""
          }
        ]
      }
    ]
  }
}
