{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid || root.child('rooms/'+$roomId+'/cohosts/'+auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['hostUid','status','createdAt','expiresAt','lastSpinAt']) && newData.child('hostUid').isString() && newData.child('status').val().matches(/^(waiting|spinning|completed)$/) && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber() && newData.child('lastSpinAt').isNumber() && (!data.exists() || (newData.child('hostUid').val() === data.child('hostUid').val() || (auth.uid === data.child('hostUid').val() && root.child('rooms/'+$roomId+'/participants').child(newData.child('hostUid').val()).exists() && root.child('rooms/'+$roomId+'/participants').child(newData.child('hostUid').val()).child('lastSeenAt').val() > now - 45000 && data.child('status').val() !== 'spinning'))) && (!data.exists() || (newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('expiresAt').val() === data.child('expiresAt').val()))"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('rooms/'+$roomId+'/meta/hostUid').val() === auth.uid && data.child('lastSeenAt').val() < now - 45000))",
            ".validate": "newData.hasChildren(['name','joinedAt','lastSeenAt','ready']) && newData.child('name').isString() && newData.child('joinedAt').isNumber() && newData.child('lastSeenAt').isNumber() && newData.child('ready').isBoolean()"
          }
        },
        "cohosts": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/'+$roomId+'/meta/hostUid').val() === auth.uid",
            ".validate": "newData.val() === true || !newData.exists()"
          }
        },
        "list": {
          ".write": "auth != null && (root.child('rooms/'+$roomId+'/meta/hostUid').val() === auth.uid || root.child('rooms/'+$roomId+'/cohosts/'+auth.uid).val() === true)",
          "$itemId": {
            ".validate": "(newData.isString() && newData.val().length > 0 && newData.val().length <= 24) || (newData.hasChildren(['name','order','createdAt','createdBy']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('order').isNumber() && newData.child('createdAt').isNumber() && newData.child('createdBy').isString() && (data.exists() || newData.child('createdBy').val() === auth.uid))"
          }
        },
        "spin": {
          ".write": "auth != null && (root.child('rooms/'+$roomId+'/meta/hostUid').val() === auth.uid || root.child('rooms/'+$roomId+'/cohosts/'+auth.uid).val() === true)",
          ".validate": "!newData.exists() || (newData.hasChildren(['spinId','winnerIndex','winnerName','startedAt','completedAt','startedBy']) && newData.child('spinId').isString() && newData.child('winnerIndex').isNumber() && newData.child('winnerName').isString() && newData.child('startedAt').isNumber() && newData.child('completedAt').isNumber() && newData.child('startedBy').val() === auth.uid)"
        },
        "reactions": {
          "$reactionId": {
            ".write": "auth != null && root.child('rooms/'+$roomId+'/participants/'+auth.uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid','name','emoji','createdAt']) && newData.child('uid').isString() && newData.child('name').isString() && newData.child('emoji').isString() && newData.child('createdAt').isNumber()"
          }
        },
        "votes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$roomId+'/participants/'+auth.uid).exists()",
            ".validate": "newData.hasChildren(['name','going','updatedAt']) && newData.child('name').isString() && newData.child('going').isBoolean() && newData.child('updatedAt').isNumber() && newData.child('spinId').isString() && newData.child('spinId').val() === root.child('rooms/'+$roomId+'/spin/spinId').val()"
          }
        },
        "preferences": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$roomId+'/participants/'+auth.uid).exists()",
            "$name": {
              ".validate": "$name.matches(/^[a-f0-9]{2,192}$/) && (newData.val() === 'prefer' || newData.val() === 'avoid')"
            }
          }
        }
      }
    },
    "challenges": {
      "$challengeId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/createdBy').val() === auth.uid && newData.child('participants/'+auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('meta/endsAt').isNumber() && data.child('meta/endsAt').val() <= now))",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt','endsAt','createdBy']) && newData.child('createdAt').isNumber() && newData.child('endsAt').isNumber() && newData.child('createdBy').isString()"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name','joinedAt']) && newData.child('name').isString() && newData.child('joinedAt').isNumber()",
            "completedDays": {
              "$dayKey": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "$dayKey.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && newData.val() === true"
              }
            }
          }
        }
      }
    },
    "discover": {
      "$geoKey": {
        ".read": "auth != null",
        "events": {
          "$eventId": {
            ".write": "auth != null && $geoKey.matches(/^[A-Za-z0-9_-]+$/) && !data.exists()",
            ".validate": "newData.hasChildren(['restaurantName','mealTime','createdAt']) && newData.child('restaurantName').isString() && newData.child('mealTime').val().matches(/^(none|breakfast|lunch|dinner)$/) && newData.child('createdAt').isNumber()"
          }
        }
      }
    },
    "usage": {
      "places": {
        "$month": {
          "$kind": {
            ".read": "auth != null",
            ".write": "auth != null && ($kind === 'nearby' || $kind === 'text' || $kind === 'autocomplete' || $kind === 'details') && $month.matches(/^[0-9]{4}-[0-9]{2}$/)",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }
      }
    },
    "sharedLists": {
      "$shareId": {
        ".read": "auth != null && (!data.exists() || data.child('expiresAt').val() > now)",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "$shareId.matches(/^[a-f0-9]{32}$/) && newData.hasChildren(['version','name','mealTime','places','createdAt','expiresAt','ownerUid'])",
        "version": {
          ".validate": "newData.val() === 1"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "mealTime": {
          ".validate": "newData.isString() && newData.val().matches(/^(any|breakfast|lunch|dinner)$/)"
        },
        "places": {
          ".validate": "newData.hasChildren() && newData.hasChild('0')",
          "$index": {
            ".validate": "$index.matches(/^(0|[1-9][0-9]?)$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 30 * 86400000"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
